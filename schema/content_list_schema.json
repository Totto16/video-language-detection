{
    "type": "array",
    "items": {
        "oneOf": [
            {
                "$ref": "#/$defs/EpisodeContent"
            },
            {
                "$ref": "#/$defs/SeasonContent"
            },
            {
                "$ref": "#/$defs/SeriesContent"
            },
            {
                "$ref": "#/$defs/CollectionContent"
            }
        ]
    },
    "$defs": {
        "EpisodeContent": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "episode"
                },
                "scanned_file": {
                    "$ref": "#/$defs/ScannedFile"
                },
                "metadata": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/MetadataHandle"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "description": {
                    "$ref": "#/$defs/EpisodeDescription"
                },
                "language": {
                    "$ref": "#/$defs/Language"
                },
                "video_metadata": {
                    "$ref": "#/$defs/VideoMetadata"
                }
            },
            "required": [
                "type",
                "scanned_file",
                "metadata",
                "description",
                "language"
            ],
            "additionalProperties": false
        },
        "ScannedFile": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "title": "file path",
                    "description": "The file path of the scanned file / folder"
                },
                "parents": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 0,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "title": "parent folders",
                    "description": "The parent folders of this scanned file / folder"
                },
                "type": {
                    "$ref": "#/$defs/ScannedFileType",
                    "title": "file type",
                    "description": "The type of the file: folder or file"
                },
                "stats": {
                    "$ref": "#/$defs/Stats",
                    "title": "file stats",
                    "description": "The stats of this file"
                }
            },
            "required": [
                "path",
                "parents",
                "type",
                "stats"
            ],
            "additionalProperties": false
        },
        "ScannedFileType": {
            "type": "string",
            "enum": [
                "file",
                "folder"
            ]
        },
        "Stats": {
            "type": "object",
            "properties": {
                "checksum": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "mtime": {
                    "type": "number"
                }
            },
            "required": [
                "checksum",
                "mtime"
            ],
            "additionalProperties": false
        },
        "MetadataHandle": {
            "oneOf": [
                {
                    "$ref": "#/$defs/ImdbHandleImpl"
                },
                {
                    "$ref": "#/$defs/TmdbHandleImpl"
                }
            ]
        },
        "ImdbHandleImpl": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "null"
                },
                "provider": {
                    "type": "string",
                    "const": "imdb"
                }
            },
            "required": [
                "data",
                "provider"
            ],
            "additionalProperties": false
        },
        "TmdbHandleImpl": {
            "type": "object",
            "properties": {
                "data": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/TMDBSkipMetadata"
                        },
                        {
                            "$ref": "#/$defs/TMDBEpisodeMetadata"
                        },
                        {
                            "$ref": "#/$defs/TMDBSeasonMetadata"
                        },
                        {
                            "$ref": "#/$defs/TMDBSeriesMetadata"
                        }
                    ]
                },
                "provider": {
                    "type": "string",
                    "const": "tmdb"
                }
            },
            "required": [
                "data",
                "provider"
            ],
            "additionalProperties": false
        },
        "TMDBSkipMetadata": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string"
                },
                "metadata_type": {
                    "type": "string",
                    "const": "skip"
                }
            },
            "required": [
                "reason",
                "metadata_type"
            ],
            "additionalProperties": false
        },
        "TMDBEpisodeMetadata": {
            "type": "object",
            "properties": {
                "air_date": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                },
                "runtime": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "vote_average": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "vote_count": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "episode_number": {
                    "type": "integer"
                },
                "metadata_type": {
                    "type": "string",
                    "const": "episode"
                }
            },
            "required": [
                "air_date",
                "runtime",
                "vote_average",
                "vote_count",
                "name",
                "episode_number",
                "metadata_type"
            ],
            "additionalProperties": false
        },
        "TMDBSeasonMetadata": {
            "type": "object",
            "properties": {
                "air_date": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                },
                "episodes_count": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "season_number": {
                    "type": "integer"
                },
                "season_id": {
                    "type": "integer"
                },
                "metadata_type": {
                    "type": "string",
                    "const": "season"
                }
            },
            "required": [
                "air_date",
                "episodes_count",
                "name",
                "season_number",
                "season_id",
                "metadata_type"
            ],
            "additionalProperties": false
        },
        "TMDBSeriesMetadata": {
            "type": "object",
            "properties": {
                "episodes_count": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "seasons_count": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "status": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "type": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "vote_average": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "vote_count": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "first_air_date": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                },
                "original_name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "series_id": {
                    "type": "integer"
                },
                "metadata_type": {
                    "type": "string",
                    "const": "series"
                }
            },
            "required": [
                "episodes_count",
                "seasons_count",
                "status",
                "type",
                "vote_average",
                "vote_count",
                "first_air_date",
                "original_name",
                "series_id",
                "metadata_type"
            ],
            "additionalProperties": false
        },
        "EpisodeDescription": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "season": {
                    "type": "integer",
                    "minimum": 0
                },
                "episode": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "name",
                "season",
                "episode"
            ],
            "additionalProperties": false
        },
        "Language": {
            "type": "object",
            "properties": {
                "short": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/Alpha2LanguageStr"
                        },
                        {
                            "$ref": "#/$defs/Alpha3LanguageStr"
                        },
                        {
                            "type": "string",
                            "const": "no_lang"
                        }
                    ]
                },
                "long": {
                    "$ref": "#/$defs/LongLanguageStr"
                }
            },
            "required": [
                "short",
                "long"
            ],
            "additionalProperties": false
        },
        "Alpha2LanguageStr": {
            "type": "string",
            "pattern": "^([a-z]{2})$"
        },
        "Alpha3LanguageStr": {
            "type": "string",
            "pattern": "^([a-z]{3})$"
        },
        "LongLanguageStr": {
            "type": "string"
        },
        "VideoMetadata": {
            "type": "object",
            "properties": {
                "duration": {
                    "type": "number"
                },
                "streams": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/VideoStreamVideo"
                            },
                            {
                                "$ref": "#/$defs/VideoStreamAudio"
                            },
                            {
                                "$ref": "#/$defs/VideoStreamSubtitle"
                            },
                            {
                                "$ref": "#/$defs/VideoStreamAttachment"
                            },
                            {
                                "$ref": "#/$defs/VideoStreamUnknown"
                            }
                        ]
                    }
                },
                "dimensions": {
                    "$ref": "#/$defs/VideoDimension"
                },
                "size": {
                    "type": "integer"
                },
                "bit_rate": {
                    "type": "number"
                }
            },
            "required": [
                "duration",
                "streams",
                "dimensions",
                "size"
            ],
            "additionalProperties": false
        },
        "VideoStreamVideo": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "video"
                },
                "duration": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "duration"
            ],
            "additionalProperties": false
        },
        "VideoStreamAudio": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "audio"
                },
                "duration": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "duration"
            ],
            "additionalProperties": false
        },
        "VideoStreamSubtitle": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "subtitle"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "VideoStreamAttachment": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "attachment"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "VideoStreamUnknown": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "unknown"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "VideoDimension": {
            "type": "object",
            "properties": {
                "width": {
                    "type": "integer"
                },
                "height": {
                    "type": "integer"
                }
            },
            "required": [
                "width",
                "height"
            ],
            "additionalProperties": false
        },
        "SeasonContent": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "season"
                },
                "scanned_file": {
                    "$ref": "#/$defs/ScannedFile"
                },
                "metadata": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/MetadataHandle"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "description": {
                    "$ref": "#/$defs/SeasonDescription"
                },
                "episodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/EpisodeContent"
                    }
                }
            },
            "required": [
                "type",
                "scanned_file",
                "metadata",
                "description",
                "episodes"
            ],
            "additionalProperties": false
        },
        "SeasonDescription": {
            "type": "object",
            "properties": {
                "season": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "season"
            ],
            "additionalProperties": false
        },
        "SeriesContent": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "series"
                },
                "scanned_file": {
                    "$ref": "#/$defs/ScannedFile"
                },
                "metadata": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/MetadataHandle"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "description": {
                    "$ref": "#/$defs/SeriesDescription"
                },
                "seasons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SeasonContent"
                    }
                }
            },
            "required": [
                "type",
                "scanned_file",
                "metadata",
                "description",
                "seasons"
            ],
            "additionalProperties": false
        },
        "SeriesDescription": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "year": {
                    "type": "integer",
                    "minimum": 1900
                }
            },
            "required": [
                "name",
                "year"
            ],
            "additionalProperties": false
        },
        "CollectionContent": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "collection"
                },
                "scanned_file": {
                    "$ref": "#/$defs/ScannedFile"
                },
                "metadata": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/MetadataHandle"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "description": {
                    "type": "string"
                },
                "series": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SeriesContent"
                    }
                }
            },
            "required": [
                "type",
                "scanned_file",
                "metadata",
                "description",
                "series"
            ],
            "additionalProperties": false
        }
    },
    "$schema": "http://json-schema.org/draft/2020-12/schema#"
}